# ==============================================================================
# QuantAntigravity-KIS Web (v2.0.0) Environment Variables Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neon Serverless PostgreSQL Database
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://username:password@ep-xxxxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Vercel Blob Storage
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 3. Korea Investment & Securities (KIS) Open API
# ------------------------------------------------------------------------------
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PRDT_CD=01
KIS_IS_PAPER_TRADING=true
# URLs (Paper Trading Defaults):
KIS_REST_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_WS_BASE_URL=ws://ops.koreainvestment.com:21000
# For Real Trading:
# KIS_REST_BASE_URL=https://openapi.koreainvestment.com:9443
# KIS_WS_BASE_URL=ws://ops.koreainvestment.com:31000

# ------------------------------------------------------------------------------
# 4. Google Gen AI (Gemini 2.0 Flash Multimodal Analysis)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Python Trading & Worker Service Inter-Service Bridge
# ------------------------------------------------------------------------------
PYTHON_WORKER_URL=http://localhost:8000
WORKER_SECRET_KEY=antigravity_kis_secret_sync_key_2026

# Next.js App Secret
JWT_SECRET=super_secret_jwt_key_here

# ------------------------------------------------------------------------------
# 6. Membership Auth (회원 가입 / 로그인 세션 서명 키)
# ------------------------------------------------------------------------------
# 세션 쿠키 HMAC 서명 키 (미설정 시 JWT_SECRET 사용, 운영에서는 반드시 변경)
AUTH_SECRET=super_secret_auth_key_change_in_production
# db-init 실행 시 기본 관리자 시드 (선택, 미설정 시 첫 가입자가 자동 admin)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change_me_immediately
# ADMIN_NAME=관리자
# 등급별 기본 계정(admin/editor/user) 초기 비밀번호 변경 (선택, 미설정 시 아래 기본값)
# SEED_ADMIN_PASSWORD=Admin1234!
# SEED_EDITOR_PASSWORD=Editor1234!
# SEED_USER_PASSWORD=User1234!
